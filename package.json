{
  "name": "discordia",
  "productName": "Discordia",
  "version": "1.3.0",
  "description": "Chat de voz, video e compartilhamento de tela com audio - simples e direto.",
  "main": "electron/main.js",
  "author": {
    "name": "Discordia",
    "email": "contato@discordia.app"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "server": "node server/server.js",
    "dist": "npm run icon && electron-builder --win nsis --x64",
    "pack": "electron-builder --dir",
    "testar-eco": "node scripts/testar-eco.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.discordia.desktop",
    "productName": "Discordia",
    "copyright": "Copyright (c) 2026 Discordia",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "server/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Discordia-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Discordia",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
